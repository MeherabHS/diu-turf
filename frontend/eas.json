{
    "cli":  {
                "version":  "\u003e= 13.2.0",
                "appVersionSource":  "remote"
            },
    "build":  {
                  "preview":  {
                                  "distribution":  "internal",
                                  "android":  {
                                                  "buildType":  "apk",
                                                  "gradleCommand":  ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a -Pandroid.enableAbiSplits=true"
                                              },
                                  "env":  {
                                              "EXPO_PUBLIC_API_BASE_URL":  "https://diu-turf.onrender.com",
                                              "EXPO_PUBLIC_DEV_AUTH_ENABLED":  "false"
                                          }
                              },
                  "production":  {
                                     "android":  {
                                                     "buildType":  "app-bundle",
                                                     "gradleCommand":  ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a"
                                                 },
                                     "env":  {
                                                 "EXPO_PUBLIC_API_BASE_URL":  "https://diu-turf.onrender.com",
                                                 "EXPO_PUBLIC_DEV_AUTH_ENABLED":  "false"
                                             }
                                 }
              }
}
